{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Private customer profile and saved delivery addresses",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 200 },
        "loyaltyPoints": { "type": "number" },
        "welcomeBonusClaimed": { "type": "boolean" },
        "completedOrdersCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "name", "phone", "createdAt", "updatedAt"]
    },
    "Wallet": {
      "title": "Customer Loyalty Wallet",
      "description": "Persistent customer points balance, daily check-in date, claimed social pages, and expiration tracking",
      "type": "object",
      "properties": {
        "customerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-+]+$" },
        "customerName": { "type": "string", "maxLength": 120 },
        "availablePoints": { "type": "number" },
        "totalEarnedPoints": { "type": "number" },
        "totalRedeemedPoints": { "type": "number" },
        "totalExpiredPoints": { "type": "number" },
        "welcomeBonusClaimed": { "type": "boolean" },
        "completedOrdersCount": { "type": "number" },
        "claimedSocialPages": { "type": "array", "items": { "type": "string" } },
        "lastDailyLoginDate": { "type": "string", "maxLength": 32 },
        "nextExpirationDate": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["customerId", "availablePoints", "welcomeBonusClaimed", "updatedAt"]
    },
    "LoyaltyTransaction": {
      "title": "Customer Loyalty Transaction",
      "description": "Ledger entry for earned, redeemed, or revoked customer loyalty points",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 64 },
        "points": { "type": "number" },
        "equivalentFils": { "type": "number" },
        "equivalentAed": { "type": "number" },
        "note": { "type": "string", "maxLength": 300 },
        "relatedOrderId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["COMPLETED", "CANCELLED"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "customerId", "type", "points", "status", "createdAt"]
    },
    "SocialFollowClaim": {
      "title": "Social Media Follow Verification Claim",
      "description": "Tracks customer @handle per social platform for admin audit and unfollow point deduction",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-+]+$" },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 120 },
        "pageId": { "type": "string", "enum": ["instagram", "tiktok", "snapchat", "facebook", "x"] },
        "handle": { "type": "string", "maxLength": 64 },
        "pointsAwarded": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "claimedAt": { "type": "string", "maxLength": 64 },
        "revokedAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "customerId", "pageId", "handle", "pointsAwarded", "status", "claimedAt", "updatedAt"]
    },
    "Order": {
      "title": "Surplus Rescue Order",
      "description": "Customer order stored in integer UAE fils with VAT and workflow status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "maxLength": 32 },
        "invoiceNumber": { "type": "string", "maxLength": 32 },
        "customerId": { "type": "string", "maxLength": 128 },
        "merchantId": { "type": "string", "maxLength": 128 },
        "subtotalFils": { "type": "number" },
        "serviceFeeFils": { "type": "number" },
        "deliveryFeeFils": { "type": "number" },
        "pointsDiscountFils": { "type": "number" },
        "vatFils": { "type": "number" },
        "totalFils": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["placed", "accepted", "preparing", "ready", "picked_up", "delivered", "completed", "cancelled"]
        },
        "fulfillmentType": { "type": "string", "enum": ["pickup"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "customerId", "merchantId", "totalFils", "status", "fulfillmentType", "createdAt", "updatedAt"]
    },
    "SurplusItem": {
      "title": "Surplus Food Item",
      "description": "Surplus food listing with integer fils pricing, pickup window, expiry time, and allergens",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "merchantId": { "type": "string", "maxLength": 128 },
        "titleEn": { "type": "string", "maxLength": 200 },
        "titleAr": { "type": "string", "maxLength": 200 },
        "originalPriceFils": { "type": "number" },
        "discountedPriceFils": { "type": "number" },
        "stockRemaining": { "type": "number" },
        "pickupStart": { "type": "string", "maxLength": 16 },
        "pickupEnd": { "type": "string", "maxLength": 16 },
        "expiryTime": { "type": "string", "maxLength": 64 },
        "allergens": { "type": "string", "maxLength": 500 },
        "ingredients": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["active", "sold_out", "paused", "expired"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "merchantId", "titleEn", "titleAr", "originalPriceFils", "discountedPriceFils", "stockRemaining", "status", "createdAt", "updatedAt"]
    },
    "Merchant": {
      "title": "Merchant Partner",
      "description": "Registered restaurant, bakery, grocery, or home kitchen partner and its commission rate",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "maxLength": 80 },
        "disabled": { "type": "boolean" },
        "name": { "type": "string", "maxLength": 160 },
        "nameAr": { "type": "string", "maxLength": 160 },
        "category": { "type": "string", "maxLength": 64 },
        "commissionPercent": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "nameAr", "commissionPercent", "isVerified", "updatedAt"]
    },
    "CommissionLog": {
      "title": "Commission Audit Log",
      "description": "Immutable audit log recording who changed a merchant commission rate, when, and old/new values",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "merchantId": { "type": "string", "maxLength": 128 },
        "changedBy": { "type": "string", "maxLength": 200 },
        "oldValue": { "type": "number" },
        "newValue": { "type": "number" },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "merchantId", "changedBy", "oldValue", "newValue", "timestamp"]
    },
    "PlatformSetting": {
      "title": "Platform Settings",
      "description": "Global platform configuration including TRN, support phone, and invoice sequence",
      "type": "object",
      "properties": {
        "businessName": { "type": "string", "maxLength": 120 },
        "trn": { "type": "string", "maxLength": 32 },
        "supportPhoneE164": { "type": "string", "maxLength": 32 },
        "defaultCommissionPercent": { "type": "number" },
        "sequentialInvoiceCounter": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["businessName", "supportPhoneE164", "defaultCommissionPercent", "updatedAt"]
    },
    "AdminRecord": {
      "title": "Admin Authorization Record",
      "description": "Admin UID allowlist document",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["super_admin", "ops_admin"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "MerchantCredential": {
      "title": "Server-Only Merchant Credential",
      "description": "Per-restaurant scrypt-hashed secret credentials and brute-force lockout state (strictly server-only)",
      "type": "object",
      "properties": {
        "merchantId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "maxLength": 80 },
        "name": { "type": "string", "maxLength": 160 },
        "nameAr": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 32 },
        "salt": { "type": "string", "maxLength": 128 },
        "secretHash": { "type": "string", "maxLength": 256 },
        "disabled": { "type": "boolean" },
        "tokenVersion": { "type": "number" },
        "failedAttempts": { "type": "number" },
        "lockedUntil": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["merchantId", "username", "salt", "secretHash", "disabled", "tokenVersion", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Private customer profiles accessible only by the owner or an admin"
    },
    "/wallets/{userId}": {
      "schema": { "$ref": "#/entities/Wallet" },
      "description": "Persistent customer loyalty wallets synced directly for the owning user and admins"
    },
    "/loyalty_transactions/{txnId}": {
      "schema": { "$ref": "#/entities/LoyaltyTransaction" },
      "description": "Customer loyalty ledger transactions readable and appendable by owner or admins"
    },
    "/social_follow_claims/{claimId}": {
      "schema": { "$ref": "#/entities/SocialFollowClaim" },
      "description": "Social follow verification handles submitted by customers and auditable/revocable by admins"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders readable/creatable by the owner or owning merchant or admin"
    },
    "/surplus_items/{itemId}": {
      "schema": { "$ref": "#/entities/SurplusItem" },
      "description": "Publicly readable active surplus listings, writable strictly by the owning merchant or admins"
    },
    "/merchants/{merchantId}": {
      "schema": { "$ref": "#/entities/Merchant" },
      "description": "Merchant directory and commission rates; editable strictly by admins"
    },
    "/merchant_credentials/{merchantId}": {
      "schema": { "$ref": "#/entities/MerchantCredential" },
      "description": "Server-only restaurant login credentials (scrypt hash + per-merchant salt); client read/write strictly denied"
    },
    "/commission_logs/{logId}": {
      "schema": { "$ref": "#/entities/CommissionLog" },
      "description": "Commission change audit trail accessible only to admins"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSetting" },
      "description": "Platform configuration including TRN and support phone; editable strictly by admins"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin UID registry"
    }
  }
}
