# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public domain where Flaster is hosted.
APP_URL="https://flaster.ae"

# 1. Ziina UAE Payment Gateway (Apple Pay & Credit/Debit Cards)
ZIINA_API_TOKEN=""
ZIINA_WEBHOOK_SECRET=""
ZIINA_TEST_MODE="false"

# 2. Server Security Secrets (Session HMAC & Pickup Code HMAC)
PORTAL_SESSION_SECRET=""
