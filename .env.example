# 3. Meta WhatsApp Business API (Webhook & Graph API secrets)
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_ID=""
META_WEBHOOK_VERIFY_TOKEN=""
META_APP_SECRET=""

# 4. Transactional Emails & Admin Alerts (Resend API - Optional)
RESEND_API_KEY=""
EMAIL_FROM="Flaster UAE <orders@flaster.ae>"
ADMIN_ALERT_EMAIL=""
